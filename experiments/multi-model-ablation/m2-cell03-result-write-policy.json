{
  "artifact": "m2-cell03-result-write-policy",
  "storyId": "B-6529",
  "contractStoryId": "B-991d",
  "status": "future_formal_row_contract_execution_not_run",
  "preparedOn": "2026-07-05",
  "appliesToEnvelopeRef": "experiments/multi-model-ablation/m2-cell03-execution-envelope.json",
  "providerCallEnabled": false,
  "resultRowsAllowedInThisStory": false,
  "outcomeRecordsAllowedInThisStory": false,
  "futureResultOutputPolicy": {
    "contractVersion": "cell03-formal-row-v1",
    "cellNumber": "03",
    "protocolCellNumber": "③",
    "arm": "A4",
    "executorFamily": "E2",
    "reviewerFamily": "same",
    "runnerId": "m2-future-cell-03-e2-a4-same",
    "futureOutputDirectory": "experiments/multi-model-ablation/future-cell03-results",
    "futureOutputReadme": "experiments/multi-model-ablation/future-cell03-results/README.md",
    "oneRowPerCellKey": true,
    "rowCountExpectedAfterFutureExecution": 1152,
    "appendOnlyAfterSeparateExecutionAuthorization": true,
    "providerCallsAllowedByThisPolicy": false,
    "resultRowsAllowedByThisStory": false,
    "outcomeRecordsAllowedByThisStory": false,
    "mustIncludeProviderReportedUsage": true,
    "mustIncludePromptDigest": true,
    "mustIncludeToolSurfaceDigest": true,
    "mustIncludeExecutorSnapshotId": true,
    "mustIncludeReviewerSnapshotId": true
  },
  "formalRowContract": {
    "version": "cell03-formal-row-v1",
    "formalUseRequiresSeparateFutureExecutionWindow": true,
    "formalRowsPresentInThisStory": false,
    "outputDirectory": "experiments/multi-model-ablation/future-cell03-results",
    "cellKeyFormat": "③|A4|{taskId}|{scenarioId}|{repeatIndex}|E2|same",
    "expectedFinalRowCount": 1152,
    "requiredFields": [
      "rowId",
      "cellKey",
      "cellNumber",
      "arm",
      "taskId",
      "taskInventoryArtifact",
      "taskInventoryDigest",
      "scenarioId",
      "repeatIndex",
      "runnerId",
      "executionWindowId",
      "executionStoryId",
      "executorSnapshotId",
      "reviewerSnapshotId",
      "promptArtifact",
      "promptDigest",
      "toolSurfaceArtifact",
      "toolSurfaceDigest",
      "providerReportedUsage",
      "rowStatus",
      "retrySupersession",
      "provenance"
    ],
    "requiredOneOfFieldSets": [
      [
        "providerReceiptRef",
        "providerResponseDigest"
      ]
    ],
    "requiredBindings": {
      "cellKey": {
        "mustBindFields": [
          "cellNumber",
          "arm",
          "taskId",
          "scenarioId",
          "repeatIndex",
          "executorFamily",
          "reviewerFamily"
        ],
        "mustMatchFormat": "③|A4|{taskId}|{scenarioId}|{repeatIndex}|E2|same",
        "duplicateFinalRowsAllowed": false
      },
      "taskId": {
        "mustExistInArtifact": "experiments/multi-model-ablation/task-inventory.m2.json",
        "mustExistAtJsonPath": "tasks[].taskId"
      },
      "taskInventoryArtifact": {
        "mustEqual": "experiments/multi-model-ablation/task-inventory.m2.json"
      },
      "taskInventoryDigest": {
        "mustEqual": "sha256:344845e8b2d4d974544fbd182c4061eff958350388133c0d08cfaa0aae4cedd4"
      },
      "scenarioId": {
        "slotCount": 16,
        "mustBindSeedScenarioSlot": true,
        "format": "scenario-slot-01..scenario-slot-16"
      },
      "repeatIndex": {
        "allowedValues": [
          1,
          2,
          3
        ],
        "mustBindSeedRepeatSlot": true
      },
      "runnerId": {
        "mustEqual": "m2-future-cell-03-e2-a4-same"
      },
      "executionWindowId": {
        "required": true,
        "mustReferenceSeparateFutureExecutionAuthorization": true,
        "mustReferenceB991dCell03ExecutionWindowWhenOpened": true,
        "mustBeOpenedByStoryId": "B-991d"
      },
      "executionStoryId": {
        "required": true,
        "mustReferenceStoryThatOpenedExecutionWindow": true,
        "mustEqualWhenWindowOpened": "B-991d"
      },
      "executorSnapshotId": {
        "mustEqual": "openai-gpt-family-readiness-2026-07-05",
        "hostLabelOnlyAccepted": false
      },
      "reviewerSnapshotId": {
        "mustEqual": "openai-gpt-family-readiness-2026-07-05",
        "hostLabelOnlyAccepted": false
      },
      "promptArtifact": {
        "mustEqual": "experiments/multi-model-ablation/m2-cell03-execution-prompt.md"
      },
      "promptDigest": {
        "mustEqual": "sha256:b1f7c70a48cf2f2c12b99bedb0f0d4259bfe334276ebf27cd1164903d33a5fa6"
      },
      "toolSurfaceArtifact": {
        "mustEqual": "experiments/multi-model-ablation/m2-cell03-tool-surface.json"
      },
      "toolSurfaceDigest": {
        "mustEqual": "sha256:c42696e2c4b36d0d1a85656000a0fc63bc5aee7158361a1f4da1279afc50beb9"
      },
      "providerReceiptRef": {
        "requiredOneOf": [
          "providerReceiptRef",
          "providerResponseDigest"
        ],
        "mustReferenceProviderResponseOrReceipt": true
      },
      "providerResponseDigest": {
        "requiredOneOf": [
          "providerReceiptRef",
          "providerResponseDigest"
        ],
        "digestAlgorithm": "sha256",
        "mustDigestRawProviderResponseOrReceipt": true
      },
      "providerReportedUsage": {
        "required": true,
        "source": "provider_reported_postflight_usage",
        "estimateAllowedAsFinalUsage": false,
        "requiredFields": [
          "inputTokens",
          "outputTokens",
          "totalTokens",
          "providerName",
          "providerModelId",
          "reportedAt"
        ]
      },
      "rowStatus": {
        "allowedValues": [
          "final",
          "failed",
          "retried",
          "superseded",
          "void"
        ],
        "formalCountingValues": [
          "final"
        ],
        "auditableNonCountingValues": [
          "failed",
          "retried",
          "superseded",
          "void"
        ]
      },
      "retrySupersession": {
        "required": true,
        "requiredFields": [
          "attemptIndex",
          "retryOfRowId",
          "supersedesRowId",
          "supersededByRowId",
          "supersessionReason"
        ],
        "maxAttemptsPerCellKey": 2,
        "maxRetriesPerCellKey": 1,
        "retryMustKeepSameCellKey": true,
        "retryMustKeepSameSnapshots": true,
        "supersededRowsMustRemainAuditable": true
      },
      "provenance": {
        "required": true,
        "requiredFields": [
          "contractStoryId",
          "contractArtifact",
          "contractVersion",
          "sourceEnvelopeRef",
          "executionStoryId",
          "executionWindowId",
          "createdAt",
          "createdBy"
        ],
        "mustInclude": {
          "contractStoryId": "B-991d",
          "contractArtifact": "experiments/multi-model-ablation/m2-cell03-result-write-policy.json",
          "contractVersion": "cell03-formal-row-v1",
          "sourceEnvelopeRef": "experiments/multi-model-ablation/m2-cell03-execution-envelope.json"
        }
      }
    },
    "uniquenessAndCountingRules": {
      "oneFinalFormalRowPerCellKey": true,
      "finalRowsKey": "cellKey",
      "finalRowPredicate": {
        "rowStatus": "final",
        "formal": true,
        "usable": true
      },
      "retryExhaustionAccounting": {
        "maxAttemptsPerCellKey": 2,
        "executionCompleteMayIncludeRetryExhaustedNonFinalRows": true,
        "retryExhaustedPredicate": {
          "hasNoFinalRowForCellKey": true,
          "attemptCountForCellKey": 2
        },
        "formalCountingEffect": {
          "formal": false,
          "usable": false,
          "countsTowardFormalResults": false,
          "countsTowardExecutionCompletion": true
        },
        "analysisBoundary": "Retry-exhausted rows prove the cell was executed under the frozen envelope and exhausted the bounded retry contract. They must remain auditable, but they must not be counted as recovered, completed, safe-stop, amplified, or any formal outcome in downstream analysis."
      },
      "duplicateFinalRowEffect": {
        "formal": false,
        "usable": false,
        "countsTowardFormalResults": false
      },
      "nonFinalRowsRemainAuditable": true,
      "nonFinalRowsCannotCountTowardExpectedFinalRowCount": true,
      "failedRetriedVoidRowsCannotCountTwice": true
    },
    "formalUsabilityFailureRules": [
      {
        "ruleId": "fallback-provider-or-model-switch",
        "whenAny": [
          {
            "field": "providerSwitchOccurred",
            "equals": true
          },
          {
            "field": "providerReportedUsage.providerModelId",
            "differsFromSnapshotBoundModel": true
          },
          {
            "field": "runnerId",
            "notEquals": "m2-future-cell-03-e2-a4-same"
          }
        ],
        "effect": {
          "formal": false,
          "usable": false
        }
      },
      {
        "ruleId": "missing-provider-reported-usage",
        "whenMissing": [
          "providerReportedUsage"
        ],
        "effect": {
          "formal": false,
          "usable": false
        }
      },
      {
        "ruleId": "estimated-usage-only",
        "whenAny": [
          {
            "field": "providerReportedUsage.source",
            "notEquals": "provider_reported_postflight_usage"
          },
          {
            "field": "providerReportedUsage.estimated",
            "equals": true
          }
        ],
        "effect": {
          "formal": false,
          "usable": false
        }
      },
      {
        "ruleId": "missing-digest-bindings",
        "whenMissingAny": [
          "promptDigest",
          "toolSurfaceDigest",
          "taskInventoryDigest",
          "providerReceiptRef_or_providerResponseDigest"
        ],
        "effect": {
          "formal": false,
          "usable": false
        }
      },
      {
        "ruleId": "host-label-only-snapshots",
        "whenAny": [
          {
            "field": "executorSnapshot.hostLabelOnly",
            "equals": true
          },
          {
            "field": "reviewerSnapshot.hostLabelOnly",
            "equals": true
          },
          {
            "field": "executorSnapshotId",
            "in": [
              "Codex CLI",
              "Codex App",
              "Claude Code CLI",
              "Antigravity CLI",
              "agy"
            ]
          },
          {
            "field": "reviewerSnapshotId",
            "in": [
              "Codex CLI",
              "Codex App",
              "Claude Code CLI",
              "Antigravity CLI",
              "agy"
            ]
          }
        ],
        "rejectedHostLabels": [
          "Codex CLI",
          "Codex App",
          "Claude Code CLI",
          "Antigravity CLI",
          "agy"
        ],
        "effect": {
          "formal": false,
          "usable": false
        }
      },
      {
        "ruleId": "missing-b-991d-provenance",
        "whenNotEquals": {
          "provenance.contractStoryId": "B-991d"
        },
        "effect": {
          "formal": false,
          "usable": false
        }
      },
      {
        "ruleId": "duplicate-final-row",
        "whenDuplicate": {
          "keyField": "cellKey",
          "where": {
            "rowStatus": "final"
          }
        },
        "effect": {
          "formal": false,
          "usable": false,
          "countsTowardFormalResults": false
        }
      }
    ]
  },
  "duplicatePolicy": {
    "duplicateCellKeysAllowed": false,
    "duplicateFinalRowsAllowed": false,
    "retryReplacementAllowedOnlyWithExplicitSupersession": true,
    "supersededRowsMustRemainAuditable": true,
    "failedRowsMustRemainAuditable": true,
    "retriedRowsMustRemainAuditable": true,
    "voidRowsMustRemainAuditable": true,
    "nonFinalRowsCountAsFormalFinalRows": false
  },
  "postflightUsageAccounting": {
    "providerReportedUsageRequiredAfterExecution": true,
    "finalUsageSource": "provider_reported_usage",
    "estimateAllowed": true,
    "estimateUse": "diagnostic_only",
    "estimateMayBeFinalUsage": false,
    "estimateMayGateLaunch": false,
    "missingProviderReportedUsageEffect": "future_execution_rows_not_formally_usable"
  },
  "nonImpactScope": {
    "cell06ExecutionAllowedByThisPolicy": false,
    "phase2ExecutionAllowedByThisPolicy": false,
    "playbookGateImpact": "none",
    "productGateImpact": "none",
    "cell06Phase2PlaybooksProductGatesUnaffected": true
  }
}
