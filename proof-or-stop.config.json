{
  "scanRoot": "packages/main",
  "rootDir": "src",
  "outDir": "packages/main/dist",
  "testsDir": "packages/main/tests",
  "fixturesDir": "packages/main/tests/fixtures",
  "storyDir": ".proof-or-stop/story/actives",
  "requirementsDir": "docs/requirements",
  "promptEnvelope": {
    "version": "proof-or-stop.prompt-envelope-rollout.v1",
    "roles": {
      "proof-or-stop-review-behavior": "full-envelope",
      "proof-or-stop-review-concept": "full-envelope",
      "proof-or-stop-review-docs": "full-envelope",
      "proof-or-stop-review-quality": "full-envelope",
      "proof-or-stop-review-test-coverage": "full-envelope",
      "proof-or-stop-review-topology-critic": "full-envelope",
      "proof-or-stop-review-story-init": "legacy-full-context",
      "proof-or-stop-review-scope-plan": "legacy-full-context",
      "proof-or-stop-implementer": "legacy-full-context",
      "proof-or-stop-review-delivery": "legacy-full-context",
      "proof-or-stop-evaluator": "legacy-full-context"
    }
  },
  "candidateSpecRouting": {
    "mode": "shadow",
    "candidateBudget": 8,
    "queryGroupBudget": 10,
    "rawHitsPerGroup": 50
  },
  "materialCode": {
    "excludePaths": [
      "experiments/"
    ]
  },
  "proofStory": {
    "devGateMode": "enforce",
    "acceptanceRolloutGateMode": "enforce",
    "reviewGateMode": "enforce",
    "doneGateMode": "enforce"
  },
  "proofAdmissibility": {
    "mode": "enforce",
    "enforcedConsumers": [
      "DONE_REQUIRED",
      "REVIEW",
      "HANDOFF",
      "AUTHORITY_GATE_DECISION"
    ]
  },
  "validate": {
    "dynamic": {
      "mode": "observe",
      "policyDefaults": {
        "assurance": "story-selectable",
        "riskTier": "local",
        "closurePolicy": "static-and-traced",
        "fullBaselineReusePolicy": "not-applicable",
        "cpuWeight": 1
      }
    },
    "commands": [
      {
        "label": "B-5a52 authorized focused graph build",
        "command": "npm",
        "args": [
          "--prefix",
          "packages/graph",
          "run",
          "build"
        ],
        "timeoutMs": 180000
      },
      {
        "label": "B-5a52 playback syntax",
        "command": "node",
        "args": [
          "--check",
          "packages/graph/src/shells/web/playback.js"
        ],
        "timeoutMs": 30000
      },
      {
        "label": "B-5a52 diff whitespace",
        "command": "git",
        "args": [
          "diff",
          "--check"
        ],
        "timeoutMs": 30000
      }
    ]
  },
  "doneRequiredCommands": [
    {
      "label": "B-5a52 authorized focused graph build",
      "command": "npm",
      "args": [
        "--prefix",
        "packages/graph",
        "run",
        "build"
      ],
      "timeoutMs": 180000
    },
    {
      "label": "B-5a52 playback syntax",
      "command": "node",
      "args": [
        "--check",
        "packages/graph/src/shells/web/playback.js"
      ],
      "timeoutMs": 30000
    },
    {
      "label": "B-5a52 diff whitespace",
      "command": "git",
      "args": [
        "diff",
        "--check"
      ],
      "timeoutMs": 30000
    }
  ],
  "baselineRiskAcceptedLocalPaths": [
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/skills/"
  ],
  "storyPrefix": "B",
  "flows": {
    "defaults": {},
    "patterns": []
  }
}
