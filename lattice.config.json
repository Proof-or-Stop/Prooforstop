      { "command": "node", "args": ["packages/main/dist/tasks/validate-focused-full-layering-smoke.js"], "focus": ["fast"] },
      { "command": "node", "args": ["packages/main/dist/tasks/main-sync-readiness-smoke.js"], "focus": ["fast"] },
      { "command": "node", "args": ["packages/main/dist/tasks/codex-adapter-gate-scope-smoke.js"], "focus": ["fast"] },
      { "command": "node", "args": ["packages/main/dist/tasks/delivery-check-freshness-smoke.js"], "focus": ["fast"] },
      "node packages/main/dist/tasks/done-required-validation-smoke.js",
