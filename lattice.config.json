      { "command": "node", "args": ["packages/main/dist/tasks/repro-evidence-binding-dev-gate-smoke.js"], "focus": ["fast"] }
    ]
  },
  "doneRequiredCommands": [
    { "label": "packages/main build", "command": "npm", "args": ["--prefix", "packages/main", "run", "build"], "timeoutMs": 290000, "providesBuildProof": "packages-main-build" },
    { "label": "root full test suite", "command": "npm", "args": ["test"], "timeoutMs": 1200000, "requiresBuildProof": "packages-main-build" }
