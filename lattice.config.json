{
  "scanRoot": "packages/main",
  "rootDir": "src",
  "outDir": "packages/main/dist",
  "testsDir": "packages/main/tests",
  "fixturesDir": "packages/main/tests/fixtures",
  "storyDir": ".lattice/story/actives",
  "requirementsDir": "docs/requirements",
  "validate": {
    "commands": [
      "npm --prefix packages/main run build",
      "node packages/main/dist/tasks/authority-client-smoke.js",
      "node packages/main/dist/tasks/authority-completion-smoke.js",
      { "command": "node", "args": ["packages/main/dist/tasks/review-pass-discard-smoke.js"], "timeoutMs": 120000 },
      { "command": "node", "args": ["packages/main/dist/tasks/init-window-data-loss-smoke.js"], "timeoutMs": 120000 }
    ]
  },
  "baselineRiskAcceptedLocalPaths": [
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/skills/"
  ],
  "storyPrefix": "B",
  "flows": {
    "defaults": {},
    "patterns": []
  }
}
