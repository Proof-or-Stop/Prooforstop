      "node packages/main/dist/tasks/done-required-head-drift-proof.js",
      "node packages/main/dist/tasks/version-bump-smoke.js",
      "node packages/main/dist/tasks/parallel-decomposition-gate-smoke.js",
      "node packages/main/dist/tasks/parallel-gate-config-smoke.js",
      "node packages/main/dist/tasks/parallel-wave-advisory-smoke.js",
      "node packages/main/dist/tasks/parallel-decomposition-gate-integration-smoke.js",
      "node packages/main/dist/tasks/adversarial-review-contract-smoke.js",
      "node packages/main/dist/tasks/adversarial-review-lens-runner-smoke.js",
      "node packages/main/dist/tasks/adversarial-review-verifier-smoke.js",
      "node packages/main/dist/tasks/adversarial-review-critic-smoke.js",
      "node packages/main/dist/tasks/adversarial-review-round-smoke.js",
      "node packages/main/dist/tasks/material-hash-large-tree-smoke.js",
      "node packages/main/dist/tasks/lifecycle-orchestrate-smoke.js",
