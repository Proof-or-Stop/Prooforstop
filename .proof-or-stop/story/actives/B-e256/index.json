{
  "storyId": "B-e256",
  "name": "global-cli-worktree-drift",
  "title": "Keep the global Proof-or-Stop executable working across dist rebuilds and worktrees",
  "description": "Story B-e256 repairs the global Proof-or-Stop CLI failure observed on 2026-09-02: a real dist rebuild emitted packages/main/dist/cli.js as mode 0644, so the npm-linked global command failed with permission denied. The accepted safety contract validates and restores package.json bin targets on the staging tree before evicting the current dist, rejects final symlinks and intermediate-directory symlink escapes, and preserves the working dist when validation fails. The doctor check remains read-only, verifies the canonical global package realpath and executable mode, reports the compiled runtime version rather than the package manifest, and renders version=unknown when compiled-version probing fails. The current understanding snapshot supersedes the older post-promotion GREEN-candidate wording.",
  "type": "bug",
  "phase": "TEST",
  "priority": "high",
  "createdAt": "2026-09-02T13:15:10.247Z",
  "startedAt": "2026-09-02T13:15:10.247Z",
