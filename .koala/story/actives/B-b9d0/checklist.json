      "id": "CHK-001",
      "title": "Define Koala-owned lifecycle artifact policy",
      "context": "Add a central policy for story-scoped Koala-generated lifecycle artifacts and command provenance, so scope logic can distinguish metadata ledger files from product source changes.",
      "relatedDocs": [
        "docs/requirements/decisions/story-lifecycle.md",
        "docs/requirements/decisions/session-ownership-and-write-leases.md",
        "docs/requirements/decisions/truth-source.md"
      ],
      "userSees": "Scope output includes \"Koala lifecycle artifact (command-generated metadata)\" for delivery-check.json and summary.json, while arbitrary files still show \"OUT_OF_SCOPE\".",
      "verificationIntent": {
        "happy": [
          {
            "desc": "A Koala command generated lifecycle artifact is classified as Koala-owned metadata with provenance.",
            "type": "logic",
            "priority": "must"
          }
        ],
        "edge": [
          {
            "desc": "The allowed lifecycle artifact list is narrow and story-scoped; unrelated files are not classified as lifecycle metadata.",
            "type": "logic",
            "priority": "must"
          }
        ],
        "adversarial": [
          {
            "desc": "A product source file or arbitrary unknown JSON still fails scope when unacknowledged.",
            "type": "logic",
            "priority": "must"
          }
        ]
      },
