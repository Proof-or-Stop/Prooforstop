.lattice/locks/
# transient mkdir-lock directories (B-d877 R2: now carry a holder.json token, so
# an accidental commit while one is briefly held would track/churn runtime state;
# these <name>.lock/ dirs — checklist/finding/review-run/init-check — are managed
# runtime locks, never story metadata).
**/*.lock/
.lattice/usage/
.Lattice/authority.md
.Lattice/artifacts/baseline/
.lattice/artifacts/baseline/
.lattice/benchmarks/memory-playbook/
# /lattice runtime artifacts (managed)

# Lattice Authority internal key-management file (may hold local private key
# material; never commit). See docs/requirements/decisions/lattice-authority-live-integration.md
.lattice/authority.md
authority_trust.env
lattice_senior_*.env
*.env
*.key

# Legacy Orchestrate evidence stays local-only. Do not bulk-copy old story or
# artifact archives into this repository's main branch.
.lattice/artifacts/
.lattice/story/legacy-*/
.lattice/story/orchestrate-legacy-*/

# c8 coverage output (B-c6cf — test:coverage script)
packages/main/coverage/

# tsc incremental build cache (regenerated; never tracked)
*.tsbuildinfo

# Local scratch / generated output (never tracked)
tmp/
output/

# Local document export artifacts (generated docx/pdf conversions, kept local-only)
/Proof-or-Stop-*.docx
/Proof-or-Stop-*.pdf

# recovery-runner experiment artifacts (large run logs, kept local-only)
experiments/recovery-runner/powered/
experiments/recovery-runner/ablation-run-records.jsonl.exclusions.jsonl
experiments/recovery-runner/analysis-out.*
