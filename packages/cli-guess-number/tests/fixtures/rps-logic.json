{
  "cases": [
    {
      "name": "judge - 石头胜剪刀",
      "input": [
        "rock",
        "scissors"
      ],
      "fn": "judge",
      "expect": "win"
    },
    {
      "name": "judge - 剪刀负石头",
      "input": [
        "scissors",
        "rock"
      ],
      "fn": "judge",
      "expect": "lose"
    },
    {
      "name": "judge - 平局",
      "input": [
        "rock",
        "rock"
      ],
      "fn": "judge",
      "expect": "draw"
    },
    {
      "name": "judge - 布胜石头",
      "input": [
        "paper",
        "rock"
      ],
      "fn": "judge",
      "expect": "win"
    },
    {
      "name": "judge - 剪刀胜布",
      "input": [
        "scissors",
        "paper"
      ],
      "fn": "judge",
      "expect": "win"
    },
    {
      "name": "parseMove - 数字输入",
      "input": [
        "1"
      ],
      "fn": "parseMove",
      "expect": "rock"
    },
    {
      "name": "parseMove - 中文输入",
      "input": [
        "剪刀"
      ],
      "fn": "parseMove",
      "expect": "scissors"
    },
    {
      "name": "parseMove - 无效输入",
      "input": [
        "abc"
      ],
      "fn": "parseMove",
      "expect": null
    },
    {
      "name": "play - 指定电脑出拳胜利",
      "input": [
        {
          "wins": 0,
          "losses": 0,
          "draws": 0,
          "rounds": 0
        },
        "rock",
        "scissors"
      ],
      "fn": "play",
      "expect": {
        "playerMove": "rock",
        "computerMove": "scissors",
        "outcome": "win"
      }
    },
    {
      "name": "play - 指定电脑出拳失败",
      "input": [
        {
          "wins": 0,
          "losses": 0,
          "draws": 0,
          "rounds": 0
        },
        "rock",
        "paper"
      ],
      "fn": "play",
      "expect": {
        "playerMove": "rock",
        "computerMove": "paper",
        "outcome": "lose"
      }
    }
