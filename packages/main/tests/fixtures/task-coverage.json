      "name": "prereq: create story with checklist",
      "fn": "story_create",
      "input": {
        "name": "t",
        "title": "Coverage Test",
        "description": "t",
        "type": "feature",
        "priority": "high"
      },
      "expect": {
        "pattern": "created"
      }
    },
    {
