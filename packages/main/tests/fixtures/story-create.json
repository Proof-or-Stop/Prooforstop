{
  "cases": [
    {
      "name": "create story with checklist (PLAN mode)",
      "input": {
        "name": "test-story",
        "title": "Test Story",
        "description": "A test story for validation",
        "type": "feature",
        "priority": "high",
        "checklist": [
          { "title": "Step 1" },
          { "title": "Step 2" }
        ]
      },
      "expect": {
        "pattern": "Story B-[a-f0-9]+ created \\(PLAN\\) with 2 checklist items"
      }
    },
    {
      "name": "create story without checklist (IDEA mode)",
      "input": {
        "name": "idea-story",
        "title": "Idea Story",
        "description": "A story without checklist",
        "type": "feature",
        "priority": "medium"
      },
      "expect": {
        "pattern": "Story B-[a-f0-9]+ created \\(IDEA\\)"
      }
    },
    {
      "name": "create story with empty checklist stays IDEA",
      "input": {
        "name": "empty-cl",
        "title": "Empty Checklist Story",
        "description": "Checklist array is empty",
        "type": "chore",
        "priority": "low",
        "checklist": []
      },
      "expect": {
        "pattern": "Story B-[a-f0-9]+ created \\(IDEA\\)"
      }
    },
    {
      "name": "create story with custom prefix",
      "input": {
        "name": "custom-prefix",
        "title": "Custom Prefix Story",
        "description": "Using X prefix",
        "type": "feature",
        "priority": "medium",
        "prefix": "X"
      },
      "expect": {
        "pattern": "Story X-[a-f0-9]+ created \\(IDEA\\)"
      }
    }
  ]
}
