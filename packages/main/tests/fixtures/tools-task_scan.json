{
  "cases": [
    {
      "name": "default JSON output contains tasks and validation",
      "input": {},
      "expect": { "pattern": "tasks" }
    },
    {
      "name": "filter by type returns only matching tasks",
      "input": { "type": "feature" },
      "expect": { "pattern": "tasks" }
    },
    {
      "name": "filter by priority returns only matching tasks",
      "input": { "priority": "high" },
      "expect": { "pattern": "tasks" }
    },
    {
      "name": "markdown format returns markdown text",
      "input": { "format": "markdown" },
      "expect": { "pattern": "##" }
    },
    {
      "name": "filter by id returns specific task",
      "input": { "id": "B-001" },
      "expect": { "pattern": "B-001" }
    }
  ]
}
