{
  "cases": [
    {
      "name": "parseMove: 数字1解析为rock",
      "input": "1",
      "fn": "parseMove",
      "expect": "rock"
    },
    {
      "name": "parseMove: 数字2解析为scissors",
      "input": "2",
      "fn": "parseMove",
      "expect": "scissors"
    },
    {
      "name": "parseMove: 数字3解析为paper",
      "input": "3",
      "fn": "parseMove",
      "expect": "paper"
    },
    {
      "name": "parseMove: 中文石头",
      "input": "石头",
      "fn": "parseMove",
      "expect": "rock"
    },
    {
      "name": "parseMove: 无效输入返回null",
      "input": "abc",
      "fn": "parseMove",
      "expect": null
    },
    {
      "name": "judge: 石头胜剪刀",
      "input": [
        "rock",
        "scissors"
      ],
      "fn": "judge",
      "expect": "win"
    },
    {
      "name": "judge: 剪刀胜布",
      "input": [
        "scissors",
        "paper"
      ],
      "fn": "judge",
      "expect": "win"
    },
    {
      "name": "judge: 布胜石头",
      "input": [
        "paper",
        "rock"
      ],
      "fn": "judge",
      "expect": "win"
    },
    {
      "name": "judge: 石头输给布",
      "input": [
        "rock",
        "paper"
      ],
      "fn": "judge",
      "expect": "lose"
    },
    {
      "name": "judge: 相同出招平局",
      "input": [
        "rock",
        "rock"
      ],
      "fn": "judge",
      "expect": "draw"
    },
    {
      "name": "play: 赢一局更新state",
      "input": [
        {
          "wins": 0,
          "losses": 0,
          "draws": 0,
          "rounds": 0
        },
        "rock",
        "scissors"
      ],
      "fn": "play",
      "expect": {
        "playerMove": "rock",
        "computerMove": "scissors",
        "outcome": "win"
      }
    },
    {
      "name": "play: 输一局更新state",
      "input": [
        {
          "wins": 0,
          "losses": 0,
          "draws": 0,
          "rounds": 0
        },
        "rock",
        "paper"
      ],
      "fn": "play",
      "expect": {
        "playerMove": "rock",
        "computerMove": "paper",
        "outcome": "lose"
      }
    }
  ]
}
