{
  "cases": [
    {
      "name": "extract single complete flow",
      "input": [
        [
          { "task": "T-001", "flow": "test-flow", "step": 1, "input": "{ id }", "output": "{ result }", "next": "stepTwo", "functionName": "stepOne", "sourceFile": "test.ts", "sourceLine": 1 },
          { "task": "T-001", "flow": "test-flow", "step": 2, "input": "{ result }", "output": "{ final }", "functionName": "stepTwo", "sourceFile": "test.ts", "sourceLine": 20 }
        ]
      ],
      "expect": { "length": 1 }
    },
    {
      "name": "extract multiple flows",
      "input": [
        [
          { "task": "T-001", "flow": "flow-a", "step": 1, "input": "{}", "output": "{}", "next": "a2", "functionName": "a1", "sourceFile": "a.ts", "sourceLine": 1 },
          { "task": "T-001", "flow": "flow-a", "step": 2, "input": "{}", "output": "{}", "functionName": "a2", "sourceFile": "a.ts", "sourceLine": 20 },
          { "task": "T-002", "flow": "flow-b", "step": 1, "input": "{}", "output": "{}", "functionName": "b1", "sourceFile": "b.ts", "sourceLine": 1 }
        ]
      ],
      "expect": { "length": 2 }
    },
    {
      "name": "no flow annotations returns empty",
      "input": [
        [
          { "task": "T-001", "functionName": "noFlow", "sourceFile": "test.ts", "sourceLine": 1 }
        ]
      ],
      "expect": { "length": 0 }
    },
    {
      "name": "empty array returns empty",
      "input": [[]],
      "expect": { "length": 0 }
    },
    {
      "name": "tasks with missing flow field are skipped",
      "input": [
        [
          { "task": "T-001", "step": 1, "functionName": "fn1", "sourceFile": "t.ts", "sourceLine": 1 },
          { "task": "T-001", "flow": null, "step": 2, "functionName": "fn2", "sourceFile": "t.ts", "sourceLine": 10 }
        ]
      ],
      "expect": { "length": 0 }
    },
    {
      "name": "tasks with missing step are skipped",
      "input": [
        [
          { "task": "T-001", "flow": "f", "functionName": "fn1", "sourceFile": "t.ts", "sourceLine": 1 }
        ]
      ],
      "expect": { "length": 0 }
    },
    {
      "name": "tasks with missing functionName are skipped",
      "input": [
        [
          { "task": "T-001", "flow": "f", "step": 1, "sourceFile": "t.ts", "sourceLine": 1 }
        ]
      ],
      "expect": { "length": 0 }
    },
    {
      "name": "duplicate step numbers produce incomplete flow",
      "input": [
        [
          { "task": "T-001", "flow": "dup", "step": 1, "input": "{}", "output": "{}", "next": "fn2", "functionName": "fn1", "sourceFile": "t.ts", "sourceLine": 1 },
          { "task": "T-001", "flow": "dup", "step": 1, "input": "{}", "output": "{}", "functionName": "fn2", "sourceFile": "t.ts", "sourceLine": 10 }
        ]
      ],
      "expect": { "length": 1 }
    },
    {
      "name": "non-continuous steps produce incomplete flow",
      "input": [
        [
          { "task": "T-001", "flow": "gap", "step": 1, "input": "{}", "output": "{}", "next": "fn3", "functionName": "fn1", "sourceFile": "t.ts", "sourceLine": 1 },
          { "task": "T-001", "flow": "gap", "step": 3, "input": "{}", "output": "{}", "functionName": "fn3", "sourceFile": "t.ts", "sourceLine": 10 }
        ]
      ],
      "expect": { "length": 1 }
    },
    {
      "name": "last step with @next produces incomplete flow",
      "input": [
        [
          { "task": "T-001", "flow": "trail", "step": 1, "input": "{}", "output": "{}", "next": "fn2", "functionName": "fn1", "sourceFile": "t.ts", "sourceLine": 1 },
          { "task": "T-001", "flow": "trail", "step": 2, "input": "{}", "output": "{}", "next": "fn3", "functionName": "fn2", "sourceFile": "t.ts", "sourceLine": 10 }
        ]
      ],
      "expect": { "length": 1 }
    }
  ]
}
