{
  "cases": [
    {
      "name": "runFlowE2E - flow 不存在时返回错误",
      "input": ["nonexistent-flow", "$SCAN_ROOT"],
      "expect": {
        "allPassed": false
      }
    },
    {
      "name": "runFlowE2E - story-lifecycle flow 全步骤通过",
      "input": ["story-lifecycle", "$SCAN_ROOT"],
      "expect": {
        "flow": "story-lifecycle",
        "allPassed": true
      }
    },
    {
      "name": "runFlowE2E - gap-convergence flow 全步骤通过",
      "input": ["gap-convergence", "$SCAN_ROOT"],
      "expect": {
        "flow": "gap-convergence",
        "allPassed": true
      }
    },
    {
      "name": "runFlowE2E - 空字符串 flow name 返回错误",
      "input": ["", "$SCAN_ROOT"],
      "expect": {
        "allPassed": false
      }
    }
  ]
}
