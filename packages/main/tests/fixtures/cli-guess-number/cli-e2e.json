{
  "cases": [
    {
      "name": "完整猜数字流程 — 猜大、猜小、猜对",
      "cli": true,
      "command": "node dist/main.js",
      "cwd": "$PROJECT_ROOT/packages/cli-guess-number",
      "env": { "GUESS_TARGET": "42" },
      "steps": [
        { "expect": "猜猜看", "input": "80" },
        { "expect": "太大了", "input": "20" },
        { "expect": "太小了", "input": "42" },
        { "expect": "恭喜" },
        { "input": "n" }
      ]
    },
    {
      "name": "中途退出显示答案",
      "cli": true,
      "command": "node dist/main.js",
      "cwd": "$PROJECT_ROOT/packages/cli-guess-number",
      "env": { "GUESS_TARGET": "42" },
      "steps": [
        { "expect": "猜猜看", "input": "q" },
        { "expect": "答案是 42" },
        { "input": "n" }
      ]
    },
    {
      "name": "无效输入后继续游戏",
      "cli": true,
      "command": "node dist/main.js",
      "cwd": "$PROJECT_ROOT/packages/cli-guess-number",
      "env": { "GUESS_TARGET": "50" },
      "steps": [
        { "expect": "猜猜看", "input": "abc" },
        { "expect": "有效数字", "input": "200" },
        { "expect": "1-100", "input": "50" },
        { "expect": "恭喜" },
        { "input": "n" }
      ]
    }
  ]
}
