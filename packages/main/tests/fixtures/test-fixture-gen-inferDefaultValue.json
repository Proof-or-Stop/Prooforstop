{
  "cases": [
    {
      "name": "inferDefaultValue - 基础类型参数",
      "input": "(name: string, count: number, enabled: boolean)",
      "expect": {
        "name": "test-name",
        "count": 1,
        "enabled": true
      }
    },
    {
      "name": "inferDefaultValue - 数组类型参数",
      "input": "(items: string[])",
      "expect": {
        "items": []
      }
    },
    {
      "name": "inferDefaultValue - 无参数函数",
      "input": "()",
      "expect": {}
    },
    {
      "name": "inferDefaultValue - 复杂对象类型参数",
      "input": "(config: Record<string, unknown>)",
      "expect": {
        "config": "test-config"
      }
    },
    {
      "name": "inferDefaultValue - 空字符串输入",
      "input": "",
      "expect": {}
    },
    {
      "name": "inferDefaultValue - 可选参数带问号",
      "input": "(name?: string, count?: number)",
      "expect": {
        "name": "test-name",
        "count": 1
      }
    },
    {
      "name": "inferDefaultValue - 未知类型参数回退为空对象",
      "input": "(xyz: SomeWeirdType)",
      "expect": {
        "xyz": {}
      }
    }
  ]
}
