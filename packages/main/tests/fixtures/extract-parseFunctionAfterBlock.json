{
  "cases": [
    {
      "name": "matches export function declaration",
      "input": ["/** @task B-001 */\nexport function doSomething(a: string, b: number): void {", 18],
      "expect": { "functionName": "doSomething", "functionSignature": "export function doSomething(a: string, b: number)" }
    },
    {
      "name": "matches async function declaration",
      "input": ["/** @task B-001 */\nexport async function fetchData(url: string): Promise<void> {", 18],
      "expect": { "functionName": "fetchData", "functionSignature": "export async function fetchData(url: string)" }
    },
    {
      "name": "matches const arrow function",
      "input": ["/** @task B-001 */\nexport const handler = (req: Request) => {", 18],
      "expect": { "functionName": "handler", "functionSignature": "export const handler = (req: Request) =>" }
    },
    {
      "name": "matches class declaration",
      "input": ["/** @task B-001 */\nexport class MyService {", 18],
      "expect": { "functionName": "MyService", "functionSignature": "export class MyService" }
    },
    {
      "name": "matches class method",
      "input": ["/** @task B-001 */\n  async processItem(item: Item): Promise<void> {", 18],
      "expect": { "functionName": "processItem", "functionSignature": "async processItem(item: Item)" }
    },
    {
      "name": "returns null for keyword",
      "input": ["/** @task B-001 */\nimport { foo } from 'bar';", 18],
      "expect": null
    }
  ]
}
