{
  "name": "@proof-or-stop/graph",
  "version": "0.1.0",
  "description": "Interactive 3D story + evidence graph for Proof-or-Stop repositories",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc && node scripts/build-web.mjs",
    "dev": "tsc --watch",
    "build:web": "node scripts/build-web.mjs",
    "audit": "node src/tasks/anchor-check.mjs && node dist/tasks/audit.js",
    "bench": "node dist/tasks/bench.js",
    "anchor-check": "node src/tasks/anchor-check.mjs",
    "check": "npm run build && npm run typecheck && npm run anchor-check && npm run verify-assets-ignored && npm run verify-clean-tree && npm run verify-no-project-writes && npm run verify-docs && npm run verify-json-no-listener && npm run verify-missing-assets-fail && npm run verify-engines-floor && npm run verify-serves && node dist/tasks/audit.js && node dist/tasks/bench.js",
    "typecheck": "tsc --noEmit && node scripts/ok.mjs GRAPH_TSC_CLEAN",
    "verify-assets-ignored": "node scripts/verify-assets-ignored.mjs",
    "verify-clean-tree": "node scripts/verify-clean-tree.mjs",
    "verify-no-project-writes": "node scripts/verify-no-project-writes.mjs",
    "verify-docs": "node scripts/verify-docs.mjs",
    "verify-serves": "node scripts/verify-serves.mjs",
    "verify-json-no-listener": "node scripts/verify-json-no-listener.mjs",
    "verify-missing-assets-fail": "node scripts/verify-missing-assets-fail.mjs",
    "verify-engines-floor": "node scripts/verify-engines-floor.mjs"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "gifenc": "^1.0.3",
    "gsap": "^3.15.0",
    "mediabunny": "^1.55.3",
    "mermaid": "^11.0.0"
  },
  "private": true
}
