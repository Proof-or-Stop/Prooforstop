{
  "storyId": "B-bf52",
  "name": "breaker-gate-failure-digest-precision",
  "title": "Stop the convergence breaker from collapsing substantively different gate failures into one repeat counter",
  "description": "gateFailureDigest normalizes a gate-rejection reason and then truncates it to 200 characters before hashing, and its normalizer also rewrites any slash-bearing token and any digit run. Four classes of substantively different rejections therefore share one counter key, so two DIFFERENT gate failures read as one gate failing twice, maxGateRepeat reaches the 2 threshold, and the convergence breaker freezes a story that was in fact making incremental progress. Unfreezing then requires an interactive human ack at a real TTY, which is the most expensive failure mode this workflow has.",
  "type": "bug",
  "phase": "REVIEW",
  "priority": "high",
  "keywords": [
    "convergence-breaker",
    "gate-failure-digest",
    "false-freeze",
    "lifecycle"
  ],
