      "status": "covered",
      "excluded_by": null,
      "source": "description"
    },
    {
      "feature": "The lock wraps the entire critical section: acquired before rmSync(dist), released after writeBuildBinding",
      "covered_by": "CHK-001:adversarial:3",
      "status": "covered",
      "excluded_by": null,
      "source": "description"
    },
    {
      "feature": "The lock is not leaked when the build fails mid-critical-section (e.g. tsc error)",
      "covered_by": "CHK-001:edge:0",
      "status": "covered",
      "excluded_by": null,
      "source": "description"
    },
    {
