    {
      "feature": "Add a cross-platform build mutex (proper-lockfile) around the build critical section",
      "covered_by": "CHK-001",
      "status": "covered",
      "excluded_by": null,
      "source": "description"
    },
    {
      "feature": "Mutex uses proper-lockfile's mkdir strategy (no flock/fcntl/native module) for cross-platform Mac/Linux/Windows support",
      "covered_by": "CHK-001:edge:2",
      "status": "covered",
      "excluded_by": null,
      "source": "description"
    },
    {
      "feature": "A live long-running build is never age-stolen from its lock (mtime heartbeat keeps a live holder fresh; stale>=30000ms and update<stale/2)",
      "covered_by": "CHK-001:adversarial:1",
      "status": "covered",
      "excluded_by": null,
      "source": "description"
    },
    {
